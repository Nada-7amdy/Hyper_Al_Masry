rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global safety net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Security Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Schema and Boundary Validation Helpers ---
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.price is number && data.price > 0
        && data.category is string && data.category.size() > 0
        && data.stock is number
        && data.isWeightBased is bool;
    }

    function isValidInvoice(data) {
      return data.invoiceNo is string && data.invoiceNo.size() > 0 && data.invoiceNo.size() <= 64
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.items is list
        && data.subtotal is number && data.subtotal >= 0
        && data.discount is number && data.discount >= 0
        && data.tax is number && data.tax >= 0
        && data.total is number && data.total >= 0
        && data.status is string && (data.status == 'synced' || data.status == 'local_pending' || data.status == 'voided');
    }

    // --- Products Collection ---
    match /products/{productId} {
      // Anyone can read product details to render POS catalouge
      allow read: if true;
      
      // Creating is restricted to authenticated users matching correct schema
      allow create: if isSignedIn() && isValidProduct(incoming());

      // Action-driven updates
      allow update: if (
        // Action 1: Stock deduction/addition via increment operations, where only 'stock' is modified
        (incoming().diff(existing()).affectedKeys().hasOnly(['stock']) && incoming().stock is number) ||
        // Action 2: Standard full-field product updates by Managers / Executives
        (isSignedIn() && isValidProduct(incoming()))
      );

      // Deleting products is restricted to authenticated managers
      allow delete: if isSignedIn();
    }

    // --- Invoices Collection ---
    match /invoices/{invoiceId} {
      // Authenticated POS terminals can scan and read invoices
      allow read: if isSignedIn();
      
      // Anyone logged in as a valid POS cashier can write invoices
      allow create: if isSignedIn() && isValidInvoice(incoming());
      
      // Invoices cannot be deleted, but can be voided (only changing 'status' field to 'voided')
      allow update: if (
        isSignedIn() && 
        isValidInvoice(incoming()) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) && 
        incoming().status == 'voided' && 
        existing().status != 'voided'
      );
      
      // Absolute Immortality Rule: deleting invoices is strictly blocked
      allow delete: if false;
    }

    // --- Order Feedback Collection (Sprint 1 & 2) ---
    match /orderFeedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if (
        incoming().deliveryRating is number && incoming().deliveryRating >= 1 && incoming().deliveryRating <= 5 &&
        incoming().productRating is number && incoming().productRating >= 1 && incoming().productRating <= 5 &&
        incoming().orderId is string && incoming().orderId.size() <= 64 &&
        incoming().tags is list &&
        incoming().comment is string && incoming().comment.size() <= 1000
      );
      allow update, delete: if false;
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if (
        incoming().orderId is string && incoming().orderId.size() <= 64 &&
        incoming().total is number && incoming().total >= 0 &&
        incoming().items is list &&
        incoming().address is string && incoming().address.size() <= 500
      );
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // --- Category Votes Collection ---
    match /categoryVotes/{voteId} {
      allow read: if true;
      allow create, update: if (
        incoming().votes is number && incoming().votes >= 0 &&
        incoming().categoryId is string && incoming().categoryId.size() <= 64
      );
      allow delete: if false;
    }

    // --- Category Subscriptions Collection ---
    match /categorySubscriptions/{subId} {
      // Authenticated managers can read subscriptions
      allow read: if isSignedIn();

      // Anyone can subscribe with valid category, email, optional categoryName, and timestamp/createdAt
      allow create: if (
        incoming().categoryId is string && incoming().categoryId.size() <= 64 &&
        incoming().email is string && incoming().email.size() <= 128 &&
        incoming().email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        (!('categoryName' in incoming()) || incoming().categoryName == null || (incoming().categoryName is string && incoming().categoryName.size() <= 100)) &&
        (
          (('timestamp' in incoming()) || ('createdAt' in incoming())) &&
          (!('timestamp' in incoming()) || incoming().timestamp is timestamp || (incoming().timestamp is string && incoming().timestamp.size() <= 64)) &&
          (!('createdAt' in incoming()) || incoming().createdAt is timestamp || (incoming().createdAt is string && incoming().createdAt.size() <= 64))
        )
      );

      // Subscriptions are strictly immutable (no updates or deletes allowed)
      allow update, delete: if false;
    }
  }
}

