rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global safety net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Security Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Schema and Boundary Validation Helpers ---
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.price is number && data.price > 0
        && data.category is string && data.category.size() > 0
        && data.stock is number
        && (!('isWeightBased' in data) || data.isWeightBased is bool);
    }

    function isValidInvoice(data) {
      return data.invoiceNo is string && data.invoiceNo.size() > 0 && data.invoiceNo.size() <= 64
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.items is list
        && data.subtotal is number && data.subtotal >= 0
        && data.discount is number && data.discount >= 0
        && data.tax is number && data.tax >= 0
        && data.total is number && data.total >= 0
        && data.status is string && (data.status == 'synced' || data.status == 'local_pending' || data.status == 'voided');
    }

    // --- Admins Collection ---
    match /admins/{adminId} {
      // Signed-in users can verify admin status
      allow read: if isSignedIn();
      // Immutable from client, prevents privilege escalation
      allow write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Customers can read and update only their own profile
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Products Collection ---
    match /products/{productId} {
      // Public catalog read
      allow read: if true;
      
      // Catalog management restricted to Admins
      allow create, delete: if isAdmin();

      // Action-driven updates: either full admin edit or inventory stock adjustments
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['stock']) && 
        incoming().stock is number
      );
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if incoming().orderId is string && incoming().orderId.size() <= 64 && incoming().total is number && incoming().total >= 0 && incoming().items is list && incoming().address is string && incoming().address.size() <= 500;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // --- Invoices Collection ---
    match /invoices/{invoiceId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidInvoice(incoming());
      allow update: if isAdmin() && 
        isValidInvoice(incoming()) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) && 
        incoming().status == 'voided' && 
        existing().status != 'voided';
      allow delete: if false;
    }

    // --- Order Feedback Collection ---
    match /orderFeedback/{feedbackId} {
      // Feedback reading restricted to Admin
      allow read: if isAdmin();
      // Customers can submit feedback according to schema
      allow create: if (
        incoming().deliveryRating is number && incoming().deliveryRating >= 1 && incoming().deliveryRating <= 5 &&
        incoming().productRating is number && incoming().productRating >= 1 && incoming().productRating <= 5 &&
        incoming().orderId is string && incoming().orderId.size() <= 64 &&
        incoming().tags is list &&
        incoming().comment is string && incoming().comment.size() <= 1000
      );
      allow update, delete: if false;
    }

    // --- Category Votes Collection ---
    match /categoryVotes/{voteId} {
      allow read: if true;
      allow create, update: if (
        incoming().votes is number && incoming().votes >= 0 &&
        incoming().categoryId is string && incoming().categoryId.size() <= 64
      );
      allow delete: if false;
    }

    // --- Category Subscriptions Collection ---
    match /categorySubscriptions/{subId} {
      // Subscriptions reading restricted to Admin
      allow read: if isAdmin();

      // Anyone can subscribe with valid category, email, optional categoryName, and timestamp/createdAt
      allow create: if (
        incoming().categoryId is string && incoming().categoryId.size() <= 64 &&
        incoming().email is string && incoming().email.size() <= 128 &&
        incoming().email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
        (!('categoryName' in incoming()) || incoming().categoryName == null || (incoming().categoryName is string && incoming().categoryName.size() <= 100)) &&
        (
          (('timestamp' in incoming()) || ('createdAt' in incoming())) &&
          (!('timestamp' in incoming()) || incoming().timestamp is timestamp || (incoming().timestamp is string && incoming().timestamp.size() <= 64)) &&
          (!('createdAt' in incoming()) || incoming().createdAt is timestamp || (incoming().createdAt is string && incoming().createdAt.size() <= 64))
        )
      );

      // Subscriptions are strictly immutable
      allow update, delete: if false;
    }
  }
}
